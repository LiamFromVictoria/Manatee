package mt

// SimpleGridProps mirrors Mantine's SimpleGrid.
type SimpleGridProps struct {
	Base
	Cols                                                                       int
	Spacing                                                                    string // xs..xl (default md) or a raw value
	VerticalSpacing                                                            string // defaults to Spacing
	ColsXs, ColsSm, ColsMd, ColsLg, ColsXl                                     int
	SpacingXs, SpacingSm, SpacingMd, SpacingLg, SpacingXl                      string
	VerticalSpacingXs, VerticalSpacingSm, VerticalSpacingMd, VerticalSpacingLg string
	VerticalSpacingXl                                                          string
}

templ SimpleGrid(p SimpleGridProps) {
	<mt-simple-grid
		{ attrs(p.Base,
			"cols", p.Cols, "spacing", p.Spacing, "vertical-spacing", p.VerticalSpacing,
			"cols-xs", p.ColsXs, "cols-sm", p.ColsSm, "cols-md", p.ColsMd, "cols-lg", p.ColsLg, "cols-xl", p.ColsXl,
			"spacing-xs", p.SpacingXs, "spacing-sm", p.SpacingSm, "spacing-md", p.SpacingMd,
			"spacing-lg", p.SpacingLg, "spacing-xl", p.SpacingXl,
			"vertical-spacing-xs", p.VerticalSpacingXs, "vertical-spacing-sm", p.VerticalSpacingSm,
			"vertical-spacing-md", p.VerticalSpacingMd, "vertical-spacing-lg", p.VerticalSpacingLg,
			"vertical-spacing-xl", p.VerticalSpacingXl,
		)... }
	>
		{ children... }
	</mt-simple-grid>
}
