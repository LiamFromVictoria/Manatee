package mt

// TextareaProps mirrors Mantine's Textarea.
type TextareaProps struct {
	Base
	Name         string
	Value        string
	Label        string
	Description  string
	Error        string
	Placeholder  string
	Variant      string // default | filled | unstyled
	Size         string
	Radius       string
	Required     bool
	Disabled     bool
	ReadOnly     bool
	AutoFocus    bool
	AutoComplete string
	MinLength    int
	MaxLength    int
	Autosize     bool
	MinRows      int
	MaxRows      int
	Resize       string // none (default) | vertical | both
	LeftSection  templ.Component
	RightSection templ.Component
	// LeftSectionWidth / RightSectionWidth override the section width (default: input height).
	LeftSectionWidth, RightSectionWidth string
}

templ Textarea(p TextareaProps) {
	<mt-textarea
		{ attrs(p.Base,
			"name", p.Name, "value", p.Value, "label", p.Label, "description", p.Description, "error", p.Error,
			"placeholder", p.Placeholder, "variant", p.Variant, "size", p.Size, "radius", p.Radius,
			"required", p.Required, "disabled", p.Disabled, "readonly", p.ReadOnly, "autofocus", p.AutoFocus,
			"autocomplete", p.AutoComplete, "minlength", p.MinLength, "maxlength", p.MaxLength,
			"autosize", p.Autosize, "min-rows", p.MinRows, "max-rows", p.MaxRows, "resize", p.Resize,
			"left-section-width", p.LeftSectionWidth, "right-section-width", p.RightSectionWidth,
		)... }
	>
		@slot("left-section", p.LeftSection)
		@slot("right-section", p.RightSection)
		{ children... }
	</mt-textarea>
}
