package mt

import "strconv"

// SliderProps mirrors Mantine's Slider. Min/Max/Value/Precision are pointers
// so an explicit zero is rendered rather than treated as unset.
type SliderProps struct {
	Base
	Name             string
	Value            *float64
	Min              *float64 // default 0
	Max              *float64 // default 100
	Step             float64  // default 1
	Precision        *int
	Color            string
	Size             string // xs..xl (default md)
	Radius           string // default xl
	ThumbSize        float64
	ThumbLabel       string // thumb aria-label
	Label            *bool  // thumb value tooltip, not a field label; false disables it (default true)
	LabelFormat      string // e.g. "{value}%" (default "{value}")
	LabelAlwaysOn    bool
	ShowLabelOnHover *bool // default true
	Marks            []SliderMark
	RestrictToMarks  bool
	Inverted         bool
	Disabled         bool
	ThumbChildren    templ.Component
}

// SliderMark is one entry rendered as a light-DOM <mt-slider-mark>, shared by Slider and RangeSlider.
type SliderMark struct {
	Value float64
	Label string
}

templ Slider(p SliderProps) {
	<mt-slider
		{ attrs(p.Base,
			"name", p.Name, "value", p.Value, "min", p.Min, "max", p.Max, "step", p.Step, "precision", p.Precision,
			"color", p.Color, "size", p.Size, "radius", p.Radius, "thumb-size", p.ThumbSize,
			"thumb-label", p.ThumbLabel, "label", p.Label, "label-format", p.LabelFormat,
			"label-always-on", p.LabelAlwaysOn, "show-label-on-hover", p.ShowLabelOnHover,
			"restrict-to-marks", p.RestrictToMarks, "inverted", p.Inverted, "disabled", p.Disabled,
		)... }
	>
		for _, m := range p.Marks {
			@sliderMarkEl(m)
		}
		@slot("thumb-children", p.ThumbChildren)
	</mt-slider>
}

templ sliderMarkEl(m SliderMark) {
	<mt-slider-mark { attrs(Base{}, "value", m.Value, "label", m.Label)... }></mt-slider-mark>
}

// RangeSliderProps mirrors Mantine's RangeSlider.
type RangeSliderProps struct {
	Base
	Name             string
	From             *float64 // default Min
	To               *float64 // default Max
	Min              *float64 // default 0
	Max              *float64 // default 100
	Step             float64  // default 1
	Precision        *int
	Color            string
	Size             string // xs..xl (default md)
	Radius           string // default xl
	ThumbSize        float64
	ThumbLabel       string
	Label            *bool
	LabelFormat      string
	LabelAlwaysOn    bool
	ShowLabelOnHover *bool // default true
	Marks            []SliderMark
	RestrictToMarks  bool
	Inverted         bool
	Disabled         bool
	MinRange         *float64 // default 10
	MaxRange         *float64 // default unlimited
	PushOnOverlap    *bool    // default true
	ThumbChildren    templ.Component
}

templ RangeSlider(p RangeSliderProps) {
	<mt-range-slider
		{ attrs(p.Base,
			"name", p.Name, "value", rangeValueAttr(p.From, p.To), "min", p.Min, "max", p.Max,
			"step", p.Step, "precision", p.Precision,
			"color", p.Color, "size", p.Size, "radius", p.Radius, "thumb-size", p.ThumbSize,
			"thumb-label", p.ThumbLabel, "label", p.Label, "label-format", p.LabelFormat,
			"label-always-on", p.LabelAlwaysOn, "show-label-on-hover", p.ShowLabelOnHover,
			"restrict-to-marks", p.RestrictToMarks, "inverted", p.Inverted, "disabled", p.Disabled,
			"min-range", p.MinRange, "max-range", p.MaxRange, "push-on-overlap", p.PushOnOverlap,
		)... }
	>
		for _, m := range p.Marks {
			@sliderMarkEl(m)
		}
		@slot("thumb-children", p.ThumbChildren)
	</mt-range-slider>
}

func rangeValueAttr(from, to *float64) string {
	if from == nil || to == nil {
		return ""
	}
	return fmtFloat(*from) + "," + fmtFloat(*to)
}

func fmtFloat(f float64) string {
	return strconv.FormatFloat(f, 'f', -1, 64)
}
