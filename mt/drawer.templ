package mt

// DrawerProps mirrors Mantine's Drawer.
type DrawerProps struct {
	Base
	Opened              bool
	Heading             string
	Position            string // left (default) | right | top | bottom
	Size                string // xs(320) sm(380) md(440, default) lg(620) xl(780), a bare number (px), "auto", or raw CSS
	WithCloseButton     *bool  // default true
	CloseOnClickOutside *bool  // default true
	CloseOnEscape       *bool  // default true
	Title               templ.Component // overrides Heading
}

// Drawer renders the <mt-drawer> host: same open()/close()/declarative
// contract as Modal, sliding in from an edge instead of fading+scaling.
templ Drawer(p DrawerProps) {
	<mt-drawer
		{ attrs(p.Base,
			"opened", p.Opened, "heading", p.Heading, "position", p.Position, "size", p.Size,
			"with-close-button", p.WithCloseButton, "close-on-click-outside", p.CloseOnClickOutside,
			"close-on-escape", p.CloseOnEscape,
		)... }
	>
		@slot("title", p.Title)
		{ children... }
	</mt-drawer>
}
