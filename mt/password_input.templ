package mt

// PasswordInputProps mirrors Mantine's PasswordInput.
type PasswordInputProps struct {
	Base
	Name         string
	Value        string
	Label        string
	Description  string
	Error        string
	Placeholder  string
	Variant      string // default | filled | unstyled
	Size         string
	Radius       string
	Required     bool
	Disabled     bool
	ReadOnly     bool
	AutoFocus    bool
	AutoComplete string
	Visible      bool
	LeftSection  templ.Component
}

templ PasswordInput(p PasswordInputProps) {
	<mt-password-input
		{ attrs(p.Base,
			"name", p.Name, "value", p.Value, "label", p.Label, "description", p.Description, "error", p.Error,
			"placeholder", p.Placeholder, "variant", p.Variant, "size", p.Size, "radius", p.Radius,
			"required", p.Required, "disabled", p.Disabled, "readonly", p.ReadOnly, "autofocus", p.AutoFocus,
			"autocomplete", p.AutoComplete, "visible", p.Visible,
		)... }
	>
		@slot("left-section", p.LeftSection)
		{ children... }
	</mt-password-input>
}
