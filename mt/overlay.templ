package mt

// OverlayProps mirrors Mantine's Overlay.
type OverlayProps struct {
	Base
	Color            string // default #000
	BackgroundOpacity *float64 // default 0.6
	Blur             int    // px
	Gradient         string // CSS gradient, overrides Color/BackgroundOpacity
	Radius           string
	ZIndex           int // default 200
	Center           bool
	Fixed            bool
}

templ Overlay(p OverlayProps) {
	<mt-overlay
		{ attrs(p.Base,
			"color", p.Color, "background-opacity", p.BackgroundOpacity, "blur", p.Blur,
			"gradient", p.Gradient, "radius", p.Radius, "z-index", p.ZIndex,
			"center", p.Center, "fixed", p.Fixed,
		)... }
	>
		{ children... }
	</mt-overlay>
}
