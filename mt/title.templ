package mt

// TitleProps mirrors Mantine's Title.
type TitleProps struct {
	Base
	Order     int // 1..6, default 1; renders a real h1..h6
	Size      string // h1..h6, or a raw CSS length, overrides the visual size
	C         string
	Ta        string
	TextWrap  string
	LineClamp int
}

templ Title(p TitleProps) {
	<mt-title
		{ attrs(p.Base, "order", p.Order, "size", p.Size, "c", p.C, "ta", p.Ta, "text-wrap", p.TextWrap, "line-clamp", p.LineClamp)... }
	>
		{ children... }
	</mt-title>
}
