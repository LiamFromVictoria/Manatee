package mt

// ActionIconProps mirrors Mantine's ActionIcon.
type ActionIconProps struct {
	Base
	Variant      string // filled (default) | light | outline | subtle | default | transparent | white | gradient
	Color        string
	Size         string // xs..xl, input-xs..input-xl
	Radius       string
	Disabled     bool
	Loading      bool
	Type         string // button (default) | submit | reset
	Href         string
	Target       string
	AriaLabel    string // required: forwarded to the inner button/anchor
	GradientFrom string
	GradientTo   string
	GradientDeg  int
}

templ ActionIcon(p ActionIconProps) {
	<mt-action-icon
		{ attrs(p.Base,
			"variant", p.Variant, "color", p.Color, "size", p.Size, "radius", p.Radius,
			"disabled", p.Disabled, "loading", p.Loading, "type", p.Type, "href", p.Href, "target", p.Target,
			"aria-label", p.AriaLabel,
			"gradient-from", p.GradientFrom, "gradient-to", p.GradientTo, "gradient-deg", p.GradientDeg,
		)... }
	>
		{ children... }
	</mt-action-icon>
}

// ActionIconGroupProps mirrors Mantine's ActionIcon.Group.
type ActionIconGroupProps struct {
	Base
	Orientation string // horizontal (default) | vertical
}

templ ActionIconGroup(p ActionIconGroupProps) {
	<mt-action-icon-group { attrs(p.Base, "orientation", p.Orientation)... }>
		{ children... }
	</mt-action-icon-group>
}
