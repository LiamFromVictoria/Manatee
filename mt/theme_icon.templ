package mt

// ThemeIconProps mirrors Mantine's ThemeIcon.
type ThemeIconProps struct {
	Base
	Variant      string // filled (default) | light | outline | default | white | transparent | gradient
	Color        string
	Size         string // xs..xl (22/28/34/44/60) or a raw number (px)
	Radius       string
	GradientFrom string
	GradientTo   string
	GradientDeg  int
}

templ ThemeIcon(p ThemeIconProps) {
	<mt-theme-icon
		{ attrs(p.Base,
			"variant", p.Variant, "color", p.Color, "size", p.Size, "radius", p.Radius,
			"gradient-from", p.GradientFrom, "gradient-to", p.GradientTo, "gradient-deg", p.GradientDeg,
		)... }
	>
		{ children... }
	</mt-theme-icon>
}
