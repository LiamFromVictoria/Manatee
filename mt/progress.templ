package mt

// ProgressProps mirrors Mantine's Progress.
type ProgressProps struct {
	Base
	Value              float64 // 0..100
	Color              string
	Size               string // xs..xl (default md)
	Radius             string
	Striped            bool
	Animated           bool
	TransitionDuration int
}

templ Progress(p ProgressProps) {
	<mt-progress
		{ attrs(p.Base,
			"value", p.Value, "color", p.Color, "size", p.Size, "radius", p.Radius,
			"striped", p.Striped, "animated", p.Animated, "transition-duration", p.TransitionDuration,
		)... }
	></mt-progress>
}

// ProgressRootProps mirrors Mantine's Progress.Root.
type ProgressRootProps struct {
	Base
	Size   string
	Radius string
}

// ProgressRoot is a flex container for ProgressSection children (multi-section progress bar).
templ ProgressRoot(p ProgressRootProps) {
	<mt-progress-root { attrs(p.Base, "size", p.Size, "radius", p.Radius)... }>
		{ children... }
	</mt-progress-root>
}

// ProgressSectionProps mirrors Mantine's Progress.Section.
type ProgressSectionProps struct {
	Base
	Value    float64 // 0..100
	Color    string
	Striped  bool
	Animated bool
}

templ ProgressSection(p ProgressSectionProps) {
	<mt-progress-section
		{ attrs(p.Base, "value", p.Value, "color", p.Color, "striped", p.Striped, "animated", p.Animated)... }
	>
		{ children... }
	</mt-progress-section>
}
