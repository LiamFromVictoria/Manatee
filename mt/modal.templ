package mt

// ModalProps mirrors Mantine's Modal.
type ModalProps struct {
	Base
	Opened              bool
	Heading             string
	Size                string // xs(320) sm(380) md(440, default) lg(620) xl(780), a bare number (px), "auto", or raw CSS (%, rem...)
	Centered            bool
	FullScreen          bool
	WithCloseButton     *bool  // default true
	CloseOnClickOutside *bool  // default true
	CloseOnEscape       *bool  // default true
	Padding             string // spacing token, default "md"
	Radius              string
	Shadow              string          // default "xl"
	YOffset             string          // default "5dvh"
	OverlayBlur         string          // blur radius in px
	Title               templ.Component // overrides Heading
}

// Modal renders the <mt-modal> host: a native <dialog> opened via
// showModal(). Call Opened: true to render it open, or use
// data-mt-open="<id>" triggers / the element's open()/close() methods.
templ Modal(p ModalProps) {
	<mt-modal
		{ attrs(p.Base,
			"opened", p.Opened, "heading", p.Heading, "size", p.Size, "centered", p.Centered, "full-screen", p.FullScreen,
			"with-close-button", p.WithCloseButton, "close-on-click-outside", p.CloseOnClickOutside,
			"close-on-escape", p.CloseOnEscape, "padding", p.Padding, "radius", p.Radius, "shadow", p.Shadow,
			"y-offset", p.YOffset, "overlay-blur", p.OverlayBlur,
		)... }
	>
		@slot("title", p.Title)
		{ children... }
	</mt-modal>
}
