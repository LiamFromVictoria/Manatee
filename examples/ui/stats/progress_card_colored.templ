package stats

import "github.com/LiamFromVictoria/Manatee/mt"

var progressCardColoredCSS = templ.NewOnceHandle()

// ProgressCardColored ports ui.mantine.dev ProgressCardColored: a blue card
// with a progress bar styled to match the card's color.
templ ProgressCardColored() {
	@progressCardColoredCSS.Once() {
		<style>
			.progress-card-colored {
				background-color: var(--mt-color-blue-filled);
			}
			.progress-card-colored__title {
				color: var(--mt-white);
				opacity: 0.65;
			}
			.progress-card-colored__stats {
				color: var(--mt-white);
			}
			.progress-card-colored__progress::part(bar) {
				background-color: var(--mt-white);
			}
			.progress-card-colored__progress::part(track) {
				background-color: var(--mt-color-blue-3);
			}
		</style>
	}
	@mt.Card(mt.CardProps{WithBorder: true, Radius: mt.MD, Padding: mt.XL, Base: mt.Base{Class: "progress-card-colored"}}) {
		@mt.Text(mt.TextProps{Tt: "uppercase", Fw: 700, Base: mt.Base{Class: "progress-card-colored__title", Fz: mt.XS}}) {
			Monthly goal
		}
		@mt.Text(mt.TextProps{Fw: 500, Base: mt.Base{Class: "progress-card-colored__stats", Fz: mt.LG}}) {
			$5.431 / $10.000
		}
		@mt.Progress(mt.ProgressProps{
			Value: 54.31, Size: mt.LG, Radius: "xl",
			Base: mt.Base{Mt: mt.MD, Class: "progress-card-colored__progress", Attrs: templ.Attributes{"aria-label": "Monthly goal progress"}},
		})
	}
}
