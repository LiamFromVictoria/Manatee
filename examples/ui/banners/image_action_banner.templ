package banners

import "github.com/you/manatee/mt"

var imageActionBannerCSS = templ.NewOnceHandle()

// ImageActionBanner ports ui.mantine.dev ImageActionBanner: a background
// image card darkened by a gradient Overlay, with a title, blurb and CTA.
templ ImageActionBanner() {
	@imageActionBannerCSS.Once() {
		<style>
			.image-action-banner {
				height: 240px;
				background-size: cover;
				background-position: center;
				background-image: url(https://images.unsplash.com/photo-1596394516093-501ba68a0ba6?ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80);
			}
			.image-action-banner__overlay { opacity: 0.55; }

			.image-action-banner__content {
				position: absolute;
				inset: 0;
				padding: var(--mt-spacing-xl);
				z-index: 1;
			}
			.image-action-banner__action {
				position: absolute;
				bottom: var(--mt-spacing-xl);
				right: var(--mt-spacing-xl);
			}
			.image-action-banner__title { color: var(--mt-white); margin-bottom: calc(var(--mt-spacing-xs) / 2); }
			.image-action-banner__description { color: var(--mt-white); max-width: 220px; }
		</style>
	}
	@mt.Card(mt.CardProps{Radius: mt.MD, Base: mt.Base{Class: "image-action-banner", Style: "position:relative"}}) {
		@mt.Overlay(mt.OverlayProps{Gradient: "linear-gradient(105deg, var(--mt-black) 20%, #312f2f 50%, var(--mt-color-gray-4) 100%)", Base: mt.Base{
			Class: "image-action-banner__overlay",
			Attrs: templ.Attributes{"z-index": "0"},
		}})
		<div class="image-action-banner__content">
			@mt.Text(mt.TextProps{Size: mt.LG, Fw: 700, Base: mt.Base{Class: "image-action-banner__title"}}) {
				Plan &amp; save
			}
			@mt.Text(mt.TextProps{Size: mt.SM, Base: mt.Base{Class: "image-action-banner__description"}}) {
				Save up to 25% at Fifth Season Hotels in Europe, the Middle East, Africa and Asia Pacific
			}
			@mt.Button(mt.ButtonProps{Variant: mt.White, Color: mt.Dark, Size: mt.XS, Base: mt.Base{Class: "image-action-banner__action"}}) {
				Book now
			}
		</div>
	}
}

