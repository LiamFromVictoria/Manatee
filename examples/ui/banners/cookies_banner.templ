package banners

import "github.com/LiamFromVictoria/Manatee/mt"

// CookiesBanner ports ui.mantine.dev CookiesBanner: a bordered card with a
// close button, a disclaimer, and preference/accept actions.
templ CookiesBanner() {
	@mt.Paper(mt.PaperProps{WithBorder: true, Radius: mt.MD, Shadow: mt.MD, Base: mt.Base{P: mt.LG}}) {
		@mt.Group(mt.GroupProps{Justify: "space-between", Base: mt.Base{Mb: mt.XS}}) {
			@mt.Text(mt.TextProps{Fw: 500, Base: mt.Base{Fz: mt.MD}}) {
				Allow cookies
			}
			@mt.CloseButton(mt.CloseButtonProps{AriaLabel: "Close cookie banner", Base: mt.Base{Mr: "-9px", Mt: "-9px"}})
		}
		@mt.Text(mt.TextProps{C: mt.Dimmed, Base: mt.Base{Fz: mt.XS}}) {
			So the deal is, we want to spy on you. We would like to know what did you have for todays
			breakfast, where do you live, how much do you earn and like 50 other things. To view our
			landing page you will have to accept all cookies. That's all, and remember that we are
			watching...
		}
		@mt.Group(mt.GroupProps{Justify: "flex-end", Base: mt.Base{Mt: mt.MD}}) {
			@mt.Button(mt.ButtonProps{Variant: mt.Default, Size: mt.XS}) {
				Cookies preferences
			}
			@mt.Button(mt.ButtonProps{Variant: mt.Outline, Size: mt.XS}) {
				Accept all
			}
		}
	}
}
