package dnd

import (
	"strconv"

	"github.com/LiamFromVictoria/Manatee/mt"
)

var dndListData = []struct {
	Position int
	Mass     string
	Symbol   string
	Name     string
}{
	{6, "12.011", "C", "Carbon"},
	{7, "14.007", "N", "Nitrogen"},
	{39, "88.906", "Y", "Yttrium"},
	{56, "137.33", "Ba", "Barium"},
	{58, "140.12", "Ce", "Cerium"},
}

var dndListCSS = templ.NewOnceHandle()

// DndList ports ui.mantine.dev DndList: a vertical list reordered by the
// Sortable web component (which replaces @dnd-kit's pointer/keyboard drag).
templ DndList() {
	@dndListCSS.Once() {
		<style>
			.dnd-list__item {
				display: flex;
				align-items: center;
				border-radius: var(--mt-radius-md);
				border: 1px solid light-dark(var(--mt-color-gray-2), var(--mt-color-dark-5));
				padding: var(--mt-spacing-sm) var(--mt-spacing-lg);
				background-color: light-dark(var(--mt-white), var(--mt-color-dark-5));
				margin-bottom: var(--mt-spacing-sm);
			}
			.dnd-list__item.mt-sortable-dragging,
			.dnd-list__item[data-sortable-lifted] {
				box-shadow: var(--mt-shadow-sm);
			}
			.dnd-list__symbol {
				font-size: 30px;
				font-weight: 700;
				width: 60px;
			}
		</style>
	}
	@mt.Sortable(mt.SortableProps{}) {
		for _, item := range dndListData {
			<div class="dnd-list__item">
				@mt.Text(mt.TextProps{Base: mt.Base{Class: "dnd-list__symbol"}}) {
					{ item.Symbol }
				}
				<div>
					@mt.Text(mt.TextProps{}) {
						{ item.Name }
					}
					@mt.Text(mt.TextProps{C: mt.Dimmed, Size: mt.SM}) {
						Position: { strconv.Itoa(item.Position) } • Mass: { item.Mass }
					}
				</div>
			</div>
		}
	}
}
