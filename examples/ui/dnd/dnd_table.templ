package dnd

import (
	"strconv"

	"github.com/you/manatee/icons"
	"github.com/you/manatee/mt"
)

var dndTableData = []struct {
	Position int
	Mass     string
	Symbol   string
	Name     string
}{
	{6, "12.011", "C", "Carbon"},
	{7, "14.007", "N", "Nitrogen"},
	{39, "88.906", "Y", "Yttrium"},
	{56, "137.33", "Ba", "Barium"},
	{58, "140.12", "Ce", "Cerium"},
}

var dndTableCSS = templ.NewOnceHandle()

// DndTable ports ui.mantine.dev DndTable: a table whose rows are reordered by
// a Sortable wrapping the whole table, scoped to tbody rows via Items, with
// drag restricted to a grip handle via Handle.
templ DndTable() {
	@dndTableCSS.Once() {
		<style>
			.dnd-table__item {
				background-color: var(--mt-color-body);
			}
			.dnd-table__drag-handle {
				width: 40px;
				display: flex;
				align-items: center;
				justify-content: center;
				height: 100%;
				color: light-dark(var(--mt-color-gray-6), var(--mt-color-dark-1));
			}
		</style>
	}
	@mt.TableScrollContainer(mt.TableScrollContainerProps{MinWidth: "420px"}) {
		@mt.Sortable(mt.SortableProps{Items: "tbody tr", Handle: ".dnd-table__drag-handle"}) {
			@mt.Table(mt.TableProps{}) {
				<thead>
					<tr>
						<th style="width:40px">
							@mt.VisuallyHidden(mt.VisuallyHiddenProps{}) {
								Drag handle
							}
						</th>
						<th style="width:80px">Position</th>
						<th style="width:120px">Name</th>
						<th style="width:40px">Symbol</th>
						<th>Mass</th>
					</tr>
				</thead>
				<tbody>
					for _, item := range dndTableData {
						<tr class="dnd-table__item">
							<td>
								<div class="dnd-table__drag-handle">
									@icons.IconGripVertical(icons.Props{Size: 18, Stroke: 1.5})
								</div>
							</td>
							<td style="width:80px">{ strconv.Itoa(item.Position) }</td>
							<td style="width:120px">{ item.Name }</td>
							<td style="width:40px">{ item.Symbol }</td>
							<td>{ item.Mass }</td>
						</tr>
					}
				</tbody>
			}
		}
	}
}
