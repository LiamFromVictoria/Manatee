package users

import "github.com/LiamFromVictoria/Manatee/mt"

type userCardImageStat struct{ Value, Label string }

var userCardImageStats = []userCardImageStat{
	{"34K", "Followers"},
	{"187", "Follows"},
	{"1.6K", "Posts"},
}

var userCardImageCSS = templ.NewOnceHandle()

templ UserCardImage() {
	@userCardImageCSS.Once() {
		<style>
			.user-card-image { background-color: var(--mt-color-body); }
			.user-card-image__avatar::part(root) {
				width: 5rem;
				height: 5rem;
				border: 2px solid var(--mt-color-body);
			}
		</style>
	}
	@mt.Card(mt.CardProps{WithBorder: true, Padding: mt.XL, Radius: mt.MD, Base: mt.Base{Class: "user-card-image"}}) {
		@mt.CardSection(mt.CardSectionProps{Base: mt.Base{
			H:     "140",
			Style: "background-image:url(https://images.unsplash.com/photo-1488590528505-98d2b5aba04b?ixlib=rb-1.2.1&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=500&q=80);background-size:cover;background-position:center",
		}})
		@mt.Avatar(mt.AvatarProps{
			Src: "https://raw.githubusercontent.com/mantinedev/mantine/master/.demo/avatars/avatar-9.png", Alt: "Bill Headbanger",
			Radius: "80",
			Base:   mt.Base{Class: "user-card-image__avatar", Mx: "auto", Mt: "-30"},
		})
		@mt.Text(mt.TextProps{Ta: "center", Size: mt.LG, Fw: 500, Base: mt.Base{Mt: mt.SM}}) {
			Bill Headbanger
		}
		@mt.Text(mt.TextProps{Ta: "center", Size: mt.SM, C: mt.Dimmed}) {
			Fullstack engineer
		}
		@mt.Group(mt.GroupProps{Justify: "center", Gap: "30", Base: mt.Base{Mt: mt.MD}}) {
			for _, s := range userCardImageStats {
				<div>
					@mt.Text(mt.TextProps{Ta: "center", Size: mt.LG, Fw: 500}) {
						{ s.Value }
					}
					@mt.Text(mt.TextProps{Ta: "center", Size: mt.SM, C: mt.Dimmed, Base: mt.Base{Style: "line-height:1"}}) {
						{ s.Label }
					}
				</div>
			}
		}
		@mt.Button(mt.ButtonProps{FullWidth: true, Radius: mt.MD, Size: mt.MD, Variant: mt.Default, Base: mt.Base{Mt: mt.XL}}) {
			Follow
		}
	}
}
