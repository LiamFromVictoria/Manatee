package footers

import (
	"github.com/you/manatee/examples/ui/blocks"
	"github.com/you/manatee/mt"
)

type footerSimpleLink struct{ Link, Label string }

var footerSimpleLinks = []footerSimpleLink{
	{"#", "Contact"},
	{"#", "Privacy"},
	{"#", "Blog"},
	{"#", "Careers"},
}

var footerSimpleCSS = templ.NewOnceHandle()

templ FooterSimple() {
	@footerSimpleCSS.Once() {
		<style>
			.footer-simple {
				margin-top: 120px;
				border-top: 1px solid light-dark(var(--mt-color-gray-2), var(--mt-color-dark-5));
			}
			.footer-simple__inner {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding-top: var(--mt-spacing-xl);
				padding-bottom: var(--mt-spacing-xl);
				@media (max-width: 36em) { flex-direction: column; }
			}
			.footer-simple__links {
				@media (max-width: 36em) { margin-top: var(--mt-spacing-md); }
			}
		</style>
	}
	<div class="footer-simple">
		@mt.Container(mt.ContainerProps{Base: mt.Base{Class: "footer-simple__inner"}}) {
			@blocks.Logo(28)
			@mt.Group(mt.GroupProps{Base: mt.Base{Class: "footer-simple__links"}}) {
				for _, l := range footerSimpleLinks {
					@mt.Anchor(mt.AnchorProps{Href: l.Link, C: mt.Dimmed, Size: mt.SM}) {
						{ l.Label }
					}
				}
			}
		}
	</div>
}
