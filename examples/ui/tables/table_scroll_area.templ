var tableScrollAreaCSS = templ.NewOnceHandle()

// TableScrollArea ports ui.mantine.dev TableScrollArea: a fixed-height
// ScrollArea with a sticky table header that grows a shadow once the user
// scrolls past the top. React's onScrollPositionChange state is replaced by a
// delegated `scroll-position-change` listener scoped to the block root,
// toggling a class on the header instead of re-rendering.
templ TableScrollArea() {
	@tableScrollAreaCSS.Once() {
		<style>
			.table-scroll-area__header {
				position: sticky;
				top: 0;
				background-color: var(--mt-color-body);
				transition: box-shadow 150ms ease;
				&::after {
					content: '';
					position: absolute;
					left: 0;
					right: 0;
					bottom: 0;
					border-bottom: 1px solid light-dark(var(--mt-color-gray-2), var(--mt-color-dark-3));
				}
			}
			.table-scroll-area__header--scrolled {
				box-shadow: var(--mt-shadow-sm);
			}
		</style>
		<script>
			document.addEventListener('scroll-position-change', (e) => {
				const root = e.target.closest && e.target.closest('.table-scroll-area');
				if (!root) return;
				const header = root.querySelector('.table-scroll-area__header');
				if (!header) return;
				header.classList.toggle('table-scroll-area__header--scrolled', e.detail.y !== 0);
			});
		</script>
	}
	@mt.ScrollArea(mt.ScrollAreaProps{Base: mt.Base{Class: "table-scroll-area", H: "300px"}}) {
		@mt.Table(mt.TableProps{Base: mt.Base{Miw: "700px"}}) {
			<thead class="table-scroll-area__header">
				<tr>
					<th>Name</th>
					<th>Email</th>
					<th>Company</th>
				</tr>
			</thead>
			<tbody>
				for _, row := range tableScrollAreaData {
					<tr>
						<td>{ row.Name }</td>
						<td>{ row.Email }</td>
						<td>{ row.Company }</td>
					</tr>
				}
			</tbody>
		}
	}
}
