package faq

import "github.com/LiamFromVictoria/Manatee/mt"

var faqSimplePlaceholder = "It can't help but hear a pin drop from over half a mile away, so it lives deep in the mountains where there aren't many people or Pokémon.It was born from sludge on the ocean floor. In a sterile environment, the germs within its body can't multiply, and it dies.It has no eyeballs, so it can't see. It checks its surroundings via the ultrasonic waves it emits from its mouth."

type faqSimpleEntry struct{ Value, Question string }

var faqSimpleEntries = []faqSimpleEntry{
	{"reset-password", "How can I reset my password?"},
	{"another-account", "Can I create more that one account?"},
	{"newsletter", "How can I subscribe to monthly newsletter?"},
	{"credit-card", "Do you store credit card information securely?"},
	{"payment", "What payment systems to you work with?"},
}

var faqSimpleCSS = templ.NewOnceHandle()

// FaqSimple ports ui.mantine.dev FaqSimple: a centered FAQ accordion.
templ FaqSimple() {
	@faqSimpleCSS.Once() {
		<style>
			.faq-simple {
				padding-top: calc(var(--mt-spacing-xl) * 2);
				padding-bottom: calc(var(--mt-spacing-xl) * 2);
				min-height: 650px;
			}
			.faq-simple__title {
				margin-bottom: calc(var(--mt-spacing-xl) * 1.5);
			}
			.faq-simple__item {
				border-radius: var(--mt-radius-md);
				margin-bottom: var(--mt-spacing-lg);
				border: 1px solid light-dark(var(--mt-color-gray-3), var(--mt-color-dark-4));
			}
		</style>
	}
	@mt.Container(mt.ContainerProps{Size: mt.SM, Base: mt.Base{Class: "faq-simple"}}) {
		@mt.Title(mt.TitleProps{Ta: "center", Base: mt.Base{Class: "faq-simple__title"}}) {
			Frequently Asked Questions
		}
		@mt.Accordion(mt.AccordionProps{Variant: "separated"}) {
			for _, e := range faqSimpleEntries {
				@mt.AccordionItem(mt.AccordionItemProps{Value: e.Value, Base: mt.Base{Class: "faq-simple__item"}}) {
					@mt.AccordionControl(mt.AccordionControlProps{}) {
						{ e.Question }
					}
					@mt.AccordionPanel(mt.AccordionPanelProps{}) {
						{ faqSimplePlaceholder }
					}
				}
			}
		}
	}
}
