package buttons

import (
	"github.com/LiamFromVictoria/Manatee/icons"
	"github.com/LiamFromVictoria/Manatee/mt"
)

var socialButtonsCSS = templ.NewOnceHandle()

templ SocialButtons() {
	@socialButtonsCSS.Once() {
		<style>
			.social-buttons__facebook::part(root) { background-color: #4267b2; color: #fff; }
			.social-buttons__facebook:hover::part(root) { background-color: #3a5a9b; }
			.social-buttons__discord::part(root) { background-color: #5865f2; color: #fff; }
			.social-buttons__discord:hover::part(root) { background-color: #525ee0; }
			.social-buttons__github::part(root) { background-color: light-dark(var(--mt-color-dark-6), var(--mt-color-dark-9)); color: #fff; }
			.social-buttons__github:hover::part(root) { background-color: light-dark(var(--mt-color-dark-6), var(--mt-color-dark-9)); }
		</style>
	}
	@mt.Group(mt.GroupProps{Justify: "center", Base: mt.Base{P: mt.MD}}) {
		@mt.Button(mt.ButtonProps{Variant: mt.Default, LeftSection: socialButtonsGoogleIcon()}) {
			Continue with Google
		}
		@mt.Button(mt.ButtonProps{
			Variant: mt.Default, Href: "https://twitter.com/mantinedev", Target: "_blank",
			LeftSection: icons.IconBrandTwitter(icons.Props{Size: 16, Color: "#00ACEE"}),
		}) {
			Follow on Twitter
		}
		@mt.Button(mt.ButtonProps{LeftSection: socialButtonsFacebookIcon(), Base: mt.Base{Class: "social-buttons__facebook"}}) {
			Sign in with Facebook
		}
		@mt.Button(mt.ButtonProps{LeftSection: icons.IconBrandGithub(icons.Props{Size: 16}), Base: mt.Base{Class: "social-buttons__github"}}) {
			Login with GitHub
		}
		@mt.Button(mt.ButtonProps{LeftSection: icons.IconBrandDiscord(icons.Props{Size: 16}), Base: mt.Base{Class: "social-buttons__discord"}}) {
			Join Discord community
		}
	}
}

templ socialButtonsGoogleIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid" viewBox="0 0 256 262" style="width:14px;height:14px">
		<path fill="#4285F4" d="M255.878 133.451c0-10.734-.871-18.567-2.756-26.69H130.55v48.448h71.947c-1.45 12.04-9.283 30.172-26.69 42.356l-.244 1.622 38.755 30.023 2.685.268c24.659-22.774 38.875-56.282 38.875-96.027"></path>
		<path fill="#34A853" d="M130.55 261.1c35.248 0 64.839-11.605 86.453-31.622l-41.196-31.913c-11.024 7.688-25.82 13.055-45.257 13.055-34.523 0-63.824-22.773-74.269-54.25l-1.531.13-40.298 31.187-.527 1.465C35.393 231.798 79.49 261.1 130.55 261.1"></path>
		<path fill="#FBBC05" d="M56.281 156.37c-2.756-8.123-4.351-16.827-4.351-25.82 0-8.994 1.595-17.697 4.206-25.82l-.073-1.73L15.26 71.312l-1.335.635C5.077 89.644 0 109.517 0 130.55s5.077 40.905 13.925 58.602l42.356-32.782"></path>
		<path fill="#EB4335" d="M130.55 50.479c24.514 0 41.05 10.589 50.479 19.438l36.844-35.974C195.245 12.91 165.798 0 130.55 0 79.49 0 35.393 29.301 13.925 71.947l42.211 32.783c10.59-31.477 39.891-54.251 74.414-54.251"></path>
	</svg>
}

templ socialButtonsFacebookIcon() {
	<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" style="width:14px;height:14px">
		<path fill="currentColor" d="M504 256C504 119 393 8 256 8S8 119 8 256c0 123.8 90.69 226.4 209.3 245V327.7h-63V256h63v-54.64c0-62.15 37-96.48 93.67-96.48 27.14 0 55.52 4.84 55.52 4.84v61h-31.28c-30.8 0-40.41 19.12-40.41 38.73V256h68.78l-11 71.69h-57.78V501C413.3 482.4 504 379.8 504 256z"></path>
	</svg>
}
