package inputs

import "github.com/LiamFromVictoria/Manatee/mt"

var forgotPasswordInputCSS = templ.NewOnceHandle()

// ForgotPasswordInput ports ui.mantine.dev ForgotPasswordInput: a password
// field with a label/"forgot password" link row above it.
templ ForgotPasswordInput() {
	@forgotPasswordInputCSS.Once() {
		<style>
			.forgot-password-input__label {
				font-size: var(--mt-font-size-sm);
				font-weight: 500;
			}
		</style>
	}
	@mt.Group(mt.GroupProps{Justify: "space-between", Base: mt.Base{Mb: "5"}}) {
		<label for="your-password" class="forgot-password-input__label">Your password</label>
		@mt.Anchor(mt.AnchorProps{Href: "#", Fw: 500, Base: mt.Base{Fz: mt.XS, Pt: "2"}}) {
			Forgot your password?
		}
	}
	@mt.PasswordInput(mt.PasswordInputProps{Placeholder: "Your password", Base: mt.Base{ID: "your-password"}})
}
