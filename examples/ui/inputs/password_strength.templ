package inputs

import (
	"github.com/you/manatee/icons"
	"github.com/you/manatee/mt"
)

type passwordStrengthRequirementDef struct{ Key, Label string }

var passwordStrengthRequirements = []passwordStrengthRequirementDef{
	{"number", "Includes number"},
	{"lower", "Includes lowercase letter"},
	{"upper", "Includes uppercase letter"},
	{"special", "Includes special symbol"},
}

var passwordStrengthCSS = templ.NewOnceHandle()

// PasswordStrength ports ui.mantine.dev PasswordStrength: a password field
// with a 4-segment strength meter and a live requirement checklist, both
// recomputed on every keystroke by a small delegated script.
templ PasswordStrength() {
	@passwordStrengthCSS.Once() {
		<style>
			.password-strength__bar::part(bar) {
				transition: none;
			}
			.password-strength__icon-check[hidden],
			.password-strength__icon-x[hidden] {
				display: none;
			}
		</style>
		<script>
			(() => {
				const requirements = [
					{ key: 'number', re: /[0-9]/ },
					{ key: 'lower', re: /[a-z]/ },
					{ key: 'upper', re: /[A-Z]/ },
					{ key: 'special', re: /[$&+,:;=?@#|'<>.^*()%!-]/ },
				];
				function strength(password) {
					let multiplier = password.length > 5 ? 0 : 1;
					for (const r of requirements) if (!r.re.test(password)) multiplier += 1;
					return Math.max(100 - (100 / (requirements.length + 1)) * multiplier, 0);
				}
				document.addEventListener('input', (e) => {
					const input = e.target;
					if (!(input instanceof HTMLElement) || !input.matches('.password-strength__input')) return;
					const root = input.closest('.password-strength');
					if (!root) return;
					const value = input.value;
					const s = strength(value);
					const color = s > 80 ? 'teal' : s > 50 ? 'yellow' : 'red';
					root.querySelectorAll('.password-strength__bar').forEach((bar, index) => {
						bar.value = value.length > 0 && index === 0 ? 100 : s >= ((index + 1) / 4) * 100 ? 100 : 0;
						bar.color = color;
					});
					const setRow = (key, meets) => {
						const row = root.querySelector(`.password-strength__requirement[data-requirement="${key}"]`);
						if (!row) return;
						row.setAttribute('c', meets ? 'teal' : 'red');
						const check = row.querySelector('.password-strength__icon-check');
						const cross = row.querySelector('.password-strength__icon-x');
						if (check) check.hidden = !meets;
						if (cross) cross.hidden = meets;
					};
					setRow('length', value.length > 5);
					for (const r of requirements) setRow(r.key, r.re.test(value));
				});
			})();
		</script>
	}
	<div class="password-strength">
		@mt.PasswordInput(mt.PasswordInputProps{
			Placeholder: "Your password",
			Label:       "Password",
			Required:    true,
			Base:        mt.Base{Class: "password-strength__input"},
		})
		@mt.Group(mt.GroupProps{Gap: "5", Grow: true, Base: mt.Base{Mt: mt.XS, Mb: mt.MD}}) {
			for i := 0; i < 4; i++ {
				@mt.Progress(mt.ProgressProps{
					Value: 0,
					Color: mt.Red,
					Size:  "4px",
					Base:  mt.Base{Class: "password-strength__bar", Attrs: templ.Attributes{"aria-label": passwordStrengthBarLabel(i)}},
				})
			}
		}
		@passwordStrengthRequirement("length", "Has at least 6 characters")
		for _, req := range passwordStrengthRequirements {
			@passwordStrengthRequirement(req.Key, req.Label)
		}
	</div>
}

func passwordStrengthBarLabel(i int) string {
	labels := []string{"1", "2", "3", "4"}
	return "Password strength segment " + labels[i]
}

templ passwordStrengthRequirement(key, label string) {
	@mt.Text(mt.TextProps{C: mt.Red, Base: mt.Base{Mt: "5", Class: "password-strength__requirement", Attrs: templ.Attributes{"data-requirement": key}}}) {
		@mt.Center(mt.CenterProps{Inline: true}) {
			<span class="password-strength__icon-check" hidden>
				@icons.IconCheck(icons.Props{Size: 14, Stroke: 1.5})
			</span>
			<span class="password-strength__icon-x">
				@icons.IconX(icons.Props{Size: 14, Stroke: 1.5})
			</span>
			@mt.Box(mt.BoxProps{Base: mt.Base{Ml: "7"}}) {
				{ label }
			}
		}
	}
}
