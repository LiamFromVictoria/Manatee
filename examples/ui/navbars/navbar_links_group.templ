package navbars

import (
	"fmt"

	"github.com/you/manatee/icons"
	"github.com/you/manatee/mt"
)

// navbarLinksGroupLink is one sub-link of a collapsible navbar links group.
type navbarLinksGroupLink struct{ Label, Link string }

// navbarLinksGroupItem is one collapsible navbar links group (ports the
// React `LinksGroup` component shared by NavbarLinksGroup and NavbarNested).
type navbarLinksGroupItem struct {
	Icon            templ.Component
	Label           string
	InitiallyOpened bool
	Links           []navbarLinksGroupLink
}

var navbarLinksGroupCSS = templ.NewOnceHandle()

// navbarLinksGroup renders one LinksGroup control (with its Collapse, if it
// has sub-links). id must be unique on the page.
templ navbarLinksGroup(id string, item navbarLinksGroupItem) {
	@navbarLinksGroupCSS.Once() {
		<style>
			.navbar-links-group__control {
				font-weight: 500;
				display: block;
				width: 100%;
				padding: var(--mt-spacing-xs) var(--mt-spacing-md);
				color: var(--mt-color-text);
				font-size: var(--mt-font-size-sm);
				border: none;
				background: none;
				cursor: pointer;
				text-align: left;
				&:hover {
					background-color: light-dark(var(--mt-color-gray-0), var(--mt-color-dark-7));
					color: light-dark(var(--mt-black), var(--mt-color-dark-0));
				}
			}
			.navbar-links-group__link {
				font-weight: 500;
				display: block;
				text-decoration: none;
				padding: var(--mt-spacing-xs) var(--mt-spacing-md);
				padding-left: var(--mt-spacing-md);
				margin-left: var(--mt-spacing-xl);
				font-size: var(--mt-font-size-sm);
				color: light-dark(var(--mt-color-gray-7), var(--mt-color-dark-0));
				border-left: 1px solid light-dark(var(--mt-color-gray-3), var(--mt-color-dark-4));
				&:hover {
					background-color: light-dark(var(--mt-color-gray-0), var(--mt-color-dark-7));
					color: light-dark(var(--mt-black), var(--mt-color-dark-0));
				}
			}
			.navbar-links-group__chevron { transition: transform 200ms ease; }
			.navbar-links-group__control[aria-expanded="true"] .navbar-links-group__chevron { transform: rotate(-90deg); }
		</style>
	}
	if len(item.Links) > 0 {
		<button type="button" class="navbar-links-group__control" data-mt-toggle={ id } aria-expanded={ fmt.Sprintf("%t", item.InitiallyOpened) }>
			@mt.Group(mt.GroupProps{Justify: "space-between", Gap: "0"}) {
				<div style="display:flex;align-items:center">
					@mt.ThemeIcon(mt.ThemeIconProps{Variant: "light", Size: "30"}) {
						@item.Icon
					}
					<div style="margin-left:var(--mt-spacing-md)">{ item.Label }</div>
				</div>
				@icons.IconChevronRight(icons.Props{Size: 16, Stroke: 1.5, Class: "navbar-links-group__chevron"})
			}
		</button>
		@mt.Collapse(mt.CollapseProps{Opened: item.InitiallyOpened, Base: mt.Base{ID: id}}) {
			for _, l := range item.Links {
				<a href="#" class="navbar-links-group__link">{ l.Label }</a>
			}
		}
	} else {
		<button type="button" class="navbar-links-group__control">
			@mt.Group(mt.GroupProps{Justify: "space-between", Gap: "0"}) {
				<div style="display:flex;align-items:center">
					@mt.ThemeIcon(mt.ThemeIconProps{Variant: "light", Size: "30"}) {
						@item.Icon
					}
					<div style="margin-left:var(--mt-spacing-md)">{ item.Label }</div>
				</div>
			}
		</button>
	}
}

// NavbarLinksGroup ports ui.mantine.dev NavbarLinksGroup: a single
// collapsible links group, as a standalone demo.
templ NavbarLinksGroup() {
	@mt.Box(mt.BoxProps{Base: mt.Base{Mih: "220", P: mt.MD}}) {
		@navbarLinksGroup("navbar-links-group-demo", navbarLinksGroupItem{
			Icon:  icons.IconCalendarStats(icons.Props{Size: 18}),
			Label: "Releases",
			Links: []navbarLinksGroupLink{
				{Label: "Upcoming releases", Link: "/"},
				{Label: "Previous releases", Link: "/"},
				{Label: "Releases schedule", Link: "/"},
			},
		})
	}
}
