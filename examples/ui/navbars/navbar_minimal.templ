package navbars

import (
	"github.com/LiamFromVictoria/Manatee/examples/ui/blocks"
	"github.com/LiamFromVictoria/Manatee/icons"
	"github.com/LiamFromVictoria/Manatee/mt"
)

type navbarMinimalLink struct {
	Icon  templ.Component
	Label string
}

var navbarMinimalLinks = []navbarMinimalLink{
	{icons.IconHome2(icons.Props{Size: 20, Stroke: 1.5}), "Home"},
	{icons.IconGauge(icons.Props{Size: 20, Stroke: 1.5}), "Dashboard"},
	{icons.IconDeviceDesktopAnalytics(icons.Props{Size: 20, Stroke: 1.5}), "Analytics"},
	{icons.IconCalendarStats(icons.Props{Size: 20, Stroke: 1.5}), "Releases"},
	{icons.IconUser(icons.Props{Size: 20, Stroke: 1.5}), "Account"},
	{icons.IconFingerprint(icons.Props{Size: 20, Stroke: 1.5}), "Security"},
	{icons.IconSettings(icons.Props{Size: 20, Stroke: 1.5}), "Settings"},
}

var navbarMinimalCSS = templ.NewOnceHandle()

// NavbarMinimal ports ui.mantine.dev NavbarMinimal: an icon-only rail with
// tooltipped links, an active one tracked via the active-group behavior.
templ NavbarMinimal() {
	@navbarMinimalCSS.Once() {
		<style>
			.navbar-minimal {
				width: 80px;
				height: 750px;
				padding: var(--mt-spacing-md);
				display: flex;
				flex-direction: column;
				border-right: 1px solid light-dark(var(--mt-color-gray-3), var(--mt-color-dark-4));
			}
			.navbar-minimal__main { flex: 1; margin-top: 50px; }
			.navbar-minimal__link {
				border: 0; background: none; padding: 0; font: inherit; cursor: pointer;
				width: 50px;
				height: 50px;
				border-radius: var(--mt-radius-md);
				display: flex;
				align-items: center;
				justify-content: center;
				color: light-dark(var(--mt-color-gray-7), var(--mt-color-dark-0));
				&:hover { background-color: light-dark(var(--mt-color-gray-0), var(--mt-color-dark-5)); }
				&[data-active] {
					&, &:hover { background-color: var(--mt-color-blue-light); color: var(--mt-color-blue-light-color); }
				}
			}
		</style>
	}
	@blocks.Behaviors()
	<nav class="navbar-minimal" data-active-group>
		@mt.Center(mt.CenterProps{}) {
			@blocks.LogoMark(30)
		}
		<div class="navbar-minimal__main">
			@mt.Stack(mt.StackProps{Justify: "center", Gap: "0"}) {
				for i, l := range navbarMinimalLinks {
					@mt.Tooltip(mt.TooltipProps{Label: l.Label, Position: "right"}) {
						<button type="button" class="navbar-minimal__link" data-active-item={ l.Label } data-active?={ i == 2 } aria-label={ l.Label }>
							@l.Icon
						</button>
					}
				}
			}
		</div>
		@mt.Stack(mt.StackProps{Justify: "center", Gap: "0"}) {
			@mt.Tooltip(mt.TooltipProps{Label: "Change account", Position: "right"}) {
				<button type="button" class="navbar-minimal__link" aria-label="Change account">
					@icons.IconSwitchHorizontal(icons.Props{Size: 20, Stroke: 1.5})
				</button>
			}
			@mt.Tooltip(mt.TooltipProps{Label: "Logout", Position: "right"}) {
				<button type="button" class="navbar-minimal__link" aria-label="Logout">
					@icons.IconLogout(icons.Props{Size: 20, Stroke: 1.5})
				</button>
			}
		}
	</nav>
}
