package navbars

import (
	"fmt"

	"github.com/you/manatee/examples/ui/blocks"
	"github.com/you/manatee/examples/ui/users"
	"github.com/you/manatee/icons"
	"github.com/you/manatee/mt"
)

var navbarNestedData = []navbarLinksGroupItem{
	{Icon: icons.IconGauge(icons.Props{Size: 18}), Label: "Dashboard"},
	{
		Icon: icons.IconNotes(icons.Props{Size: 18}), Label: "Market news", InitiallyOpened: true,
		Links: []navbarLinksGroupLink{
			{Label: "Overview", Link: "/"},
			{Label: "Forecasts", Link: "/"},
			{Label: "Outlook", Link: "/"},
			{Label: "Real time", Link: "/"},
		},
	},
	{
		Icon: icons.IconCalendarStats(icons.Props{Size: 18}), Label: "Releases",
		Links: []navbarLinksGroupLink{
			{Label: "Upcoming releases", Link: "/"},
			{Label: "Previous releases", Link: "/"},
			{Label: "Releases schedule", Link: "/"},
		},
	},
	{Icon: icons.IconPresentationAnalytics(icons.Props{Size: 18}), Label: "Analytics"},
	{Icon: icons.IconFileAnalytics(icons.Props{Size: 18}), Label: "Contracts"},
	{Icon: icons.IconAdjustments(icons.Props{Size: 18}), Label: "Settings"},
	{
		Icon: icons.IconLock(icons.Props{Size: 18}), Label: "Security",
		Links: []navbarLinksGroupLink{
			{Label: "Enable 2FA", Link: "/"},
			{Label: "Change password", Link: "/"},
			{Label: "Recovery codes", Link: "/"},
		},
	},
}

var navbarNestedCSS = templ.NewOnceHandle()

// NavbarNested ports ui.mantine.dev NavbarNested: a logo+version header, a
// scrollable list of LinksGroup controls, and a UserButton footer.
templ NavbarNested() {
	@navbarNestedCSS.Once() {
		<style>
			.navbar-nested {
				background-color: light-dark(var(--mt-white), var(--mt-color-dark-6));
				height: 800px;
				width: 300px;
				padding: var(--mt-spacing-md);
				padding-bottom: 0;
				display: flex;
				flex-direction: column;
				border-right: 1px solid light-dark(var(--mt-color-gray-3), var(--mt-color-dark-4));
			}
			.navbar-nested__header {
				padding: var(--mt-spacing-md);
				padding-top: 0;
				margin-left: calc(var(--mt-spacing-md) * -1);
				margin-right: calc(var(--mt-spacing-md) * -1);
				color: light-dark(var(--mt-black), var(--mt-white));
				border-bottom: 1px solid light-dark(var(--mt-color-gray-3), var(--mt-color-dark-4));
			}
			.navbar-nested__links {
				flex: 1;
				margin-left: calc(var(--mt-spacing-md) * -1);
				margin-right: calc(var(--mt-spacing-md) * -1);
			}
			.navbar-nested__links-inner { padding-top: var(--mt-spacing-xl); padding-bottom: var(--mt-spacing-xl); }
			.navbar-nested__footer {
				margin-left: calc(var(--mt-spacing-md) * -1);
				margin-right: calc(var(--mt-spacing-md) * -1);
				border-top: 1px solid light-dark(var(--mt-color-gray-3), var(--mt-color-dark-4));
			}
		</style>
	}
	<nav class="navbar-nested">
		<div class="navbar-nested__header">
			@mt.Group(mt.GroupProps{Justify: "space-between"}) {
				@blocks.Logo(24)
				@mt.Code(mt.CodeProps{Base: mt.Base{Style: "font-weight:700"}}) { v3.1.2 }
			}
		</div>
		@mt.ScrollArea(mt.ScrollAreaProps{Base: mt.Base{Class: "navbar-nested__links"}}) {
			<div class="navbar-nested__links-inner">
				for i, item := range navbarNestedData {
					@navbarLinksGroup(fmt.Sprintf("navbar-nested-group-%d", i), item)
				}
			</div>
		}
		<div class="navbar-nested__footer">
			@users.UserButton()
		</div>
	</nav>
}
