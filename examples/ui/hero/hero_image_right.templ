package hero

import "github.com/LiamFromVictoria/Manatee/mt"

var heroImageRightCSS = templ.NewOnceHandle()

// HeroImageRight ports ui.mantine.dev HeroImageRight: dark photo background
// with left-aligned gradient title, description and CTA.
templ HeroImageRight() {
	@heroImageRightCSS.Once() {
		<style>
			.hero-image-right {
				background-color: #11284b;
				background-size: cover;
				background-position: center;
				background-image:
					linear-gradient(250deg, rgba(130, 201, 30, 0) 0%, #062343 70%),
					url(https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-1.2.1&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8&auto=format&fit=crop&w=1080&q=80);
				padding-top: calc(var(--mt-spacing-xl) * 3);
				padding-bottom: calc(var(--mt-spacing-xl) * 3);
			}
			.hero-image-right__inner {
				display: flex;
				justify-content: space-between;
			}
			@media (max-width: 62em) {
				.hero-image-right__inner { flex-direction: column; }
			}
			.hero-image-right__content {
				padding-top: calc(var(--mt-spacing-xl) * 2);
				padding-bottom: calc(var(--mt-spacing-xl) * 2);
				margin-right: calc(var(--mt-spacing-xl) * 3);
			}
			@media (max-width: 62em) {
				.hero-image-right__content { margin-right: 0; }
			}
			.hero-image-right__title {
				color: var(--mt-white);
				font-family: Outfit, var(--mt-font-family);
				font-weight: 500;
				line-height: 1.05;
				max-width: 500px;
				font-size: 48px;
			}
			@media (max-width: 62em) {
				.hero-image-right__title { max-width: 100%; font-size: 34px; line-height: 1.15; }
			}
			.hero-image-right__description {
				color: var(--mt-white);
				opacity: 0.75;
				max-width: 500px;
			}
			@media (max-width: 62em) {
				.hero-image-right__description { max-width: 100%; }
			}
			.hero-image-right__control {
				padding-left: 50px;
				padding-right: 50px;
				font-family: Outfit, var(--mt-font-family);
				font-size: 22px;
			}
			@media (max-width: 62em) {
				.hero-image-right__control { width: 100%; }
			}
		</style>
	}
	<div class="hero-image-right">
		@mt.Container(mt.ContainerProps{Size: mt.LG}) {
			<div class="hero-image-right__inner">
				<div class="hero-image-right__content">
					@mt.Title(mt.TitleProps{Order: 1, Base: mt.Base{Class: "hero-image-right__title"}}) {
						A{ " " }
						@mt.Text(mt.TextProps{Span: true, Inherit: true, Variant: mt.Gradient, GradientFrom: mt.Pink, GradientTo: mt.Yellow}) {
							fully featured
						}{ " " }
						React components library
					}
					@mt.Text(mt.TextProps{Base: mt.Base{Class: "hero-image-right__description", Mt: "30"}}) {
						Build fully functional accessible web applications with ease – Mantine includes more than 100 customizable components and hooks to cover you in any situation
					}
					@mt.Button(mt.ButtonProps{
						Variant: mt.Gradient, GradientFrom: mt.Pink, GradientTo: mt.Yellow, Size: mt.XL,
						Base: mt.Base{Class: "hero-image-right__control", Mt: "40"},
					}) {
						Get started
					}
				</div>
			</div>
		}
	</div>
}
