package hero

import "github.com/LiamFromVictoria/Manatee/mt"

var heroContentLeftCSS = templ.NewOnceHandle()

// HeroContentLeft ports ui.mantine.dev HeroContentLeft: full-bleed photo with a
// dark gradient overlay and bottom-left-aligned content.
templ HeroContentLeft() {
	@heroContentLeftCSS.Once() {
		<style>
			.hero-content-left {
				position: relative;
				background-image: url(https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-1.2.1&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=1770&q=80);
				background-size: cover;
				background-position: center;
			}
			.hero-content-left__container {
				height: 700px;
				display: flex;
				flex-direction: column;
				justify-content: flex-end;
				align-items: flex-start;
				padding-bottom: calc(var(--mt-spacing-xl) * 6);
				z-index: 1;
				position: relative;
			}
			@media (max-width: 48em) {
				.hero-content-left__container { height: 500px; padding-bottom: calc(var(--mt-spacing-xl) * 3); }
			}
			.hero-content-left__title {
				color: var(--mt-white);
				font-weight: 500;
			}
			.hero-content-left__title::part(root) {
				font-size: 60px;
				line-height: 1.1;
			}
			@media (max-width: 48em) {
				.hero-content-left__title::part(root) { font-size: 40px; line-height: 1.2; }
			}
			@media (max-width: 36em) {
				.hero-content-left__title::part(root) { font-size: 28px; line-height: 1.3; }
			}
			.hero-content-left__description {
				color: var(--mt-white);
				max-width: 600px;
			}
			@media (max-width: 48em) {
				.hero-content-left__description { max-width: 100%; font-size: var(--mt-font-size-sm); }
			}
			.hero-content-left__control {
				margin-top: calc(var(--mt-spacing-xl) * 1.5);
			}
			@media (max-width: 48em) {
				.hero-content-left__control { width: 100%; }
			}
		</style>
	}
	<div class="hero-content-left">
		@mt.Overlay(mt.OverlayProps{
			Gradient: "linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, .65) 40%)",
			BackgroundOpacity: new(1.0),
			Base: mt.Base{Attrs: templ.Attributes{"z-index": "0"}},
		})
		@mt.Container(mt.ContainerProps{Size: mt.MD, Base: mt.Base{Class: "hero-content-left__container"}}) {
			@mt.Title(mt.TitleProps{Order: 1, Base: mt.Base{Class: "hero-content-left__title"}}) {
				A fully featured Go components library
			}
			@mt.Text(mt.TextProps{Size: mt.XL, Base: mt.Base{Class: "hero-content-left__description", Mt: mt.XL}}) {
				Build fully functional accessible web applications faster than ever – Manatee includes more than 70 customizable components to cover you in any situation
			}
			@mt.Button(mt.ButtonProps{Variant: mt.Gradient, Size: mt.XL, Radius: mt.XL, Base: mt.Base{Class: "hero-content-left__control"}}) {
				Get started
			}
		}
	</div>
}
