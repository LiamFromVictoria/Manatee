package sliders

import (
	"github.com/you/manatee/icons"
	"github.com/you/manatee/mt"
)

var sliderMarksMarks = []mt.SliderMark{
	{Value: 0, Label: "0"},
	{Value: 12.5, LabelContent: sliderMarksDot()},
	{Value: 25, Label: "25"},
	{Value: 37.5, LabelContent: sliderMarksDot()},
	{Value: 50, Label: "50"},
	{Value: 62.5, LabelContent: sliderMarksDot()},
	{Value: 75, Label: "75"},
	{Value: 87.5, LabelContent: sliderMarksDot()},
	{Value: 100, Label: "100"},
}

var sliderMarksCSS = templ.NewOnceHandle()

// SliderMarks ports ui.mantine.dev SliderMarks: a range slider with numbered
// and dotted marks, and a grip-icon thumb.
templ SliderMarks() {
	@sliderMarksCSS.Once() {
		<style>
			.slider-marks::part(thumb-from), .slider-marks::part(thumb-to) {
				width: 16px;
				height: 28px;
				background-color: var(--mt-white);
				color: var(--mt-color-gray-5);
				border: 1px solid light-dark(var(--mt-color-gray-3), var(--mt-color-dark-2));
			}
		</style>
	}
	@mt.RangeSlider(mt.RangeSliderProps{
		From: new(30.0), To: new(60.0), Marks: sliderMarksMarks,
		ThumbChildren:  sliderMarksThumb(),
		ThumbFromLabel: "Start",
		ThumbToLabel:   "End",
		Base:           mt.Base{Class: "slider-marks", Mt: mt.XL, Mb: mt.XL},
	})
}

templ sliderMarksThumb() {
	@icons.IconGripVertical(icons.Props{Size: 20, Stroke: 1.5})
}

templ sliderMarksDot() {
	@icons.IconPoint(icons.Props{Size: 10, Stroke: 1.5, Style: "margin-top: 6px"})
}
