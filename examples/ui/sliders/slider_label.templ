package sliders

import "github.com/LiamFromVictoria/Manatee/mt"

var sliderLabelCSS = templ.NewOnceHandle()

// SliderLabel ports ui.mantine.dev SliderLabel: a range slider whose value
// labels stay permanently visible as pill-shaped thumbs.
templ SliderLabel() {
	@sliderLabelCSS.Once() {
		<style>
			.slider-label::part(label) {
				top: 0;
				height: 28px;
				line-height: 28px;
				width: 34px;
				padding: 0;
				display: flex;
				justify-content: center;
				align-items: center;
				font-weight: 700;
				background-color: transparent;
			}
			.slider-label::part(thumb-from), .slider-label::part(thumb-to) {
				background-color: var(--mt-color-blue-6);
				height: 28px;
				width: 34px;
				border: none;
			}
		</style>
	}
	@mt.RangeSlider(mt.RangeSliderProps{
		LabelAlwaysOn: true, From: new(20.0), To: new(60.0),
		ThumbFromLabel: "Start value", ThumbToLabel: "End value",
		Base: mt.Base{Class: "slider-label"},
	})
}
