package authentication

import "github.com/LiamFromVictoria/Manatee/mt"
import "github.com/LiamFromVictoria/Manatee/icons"

var forgotPasswordCSS = templ.NewOnceHandle()

// ForgotPassword ports ui.mantine.dev ForgotPassword: a reset-link request
// card with a "back to login" link and submit button.
templ ForgotPassword() {
	@forgotPasswordCSS.Once() {
		<style>
			.forgot-password__title {
				font-size: 26px;
				font-weight: 500;
				font-family: Outfit, var(--mt-font-family);
			}
			.forgot-password__controls {
				@media (max-width: 36em) {
					flex-direction: column-reverse;
				}
			}
			.forgot-password__control {
				@media (max-width: 36em) {
					width: 100%;
					text-align: center;
				}
			}
		</style>
	}
	@mt.Container(mt.ContainerProps{Size: "460", Base: mt.Base{My: "30"}}) {
		@mt.Title(mt.TitleProps{Ta: "center", Base: mt.Base{Class: "forgot-password__title"}}) {
			Forgot your password?
		}
		@mt.Text(mt.TextProps{C: mt.Dimmed, Ta: "center", Base: mt.Base{Fz: mt.SM}}) {
			Enter your email to get a reset link
		}
		@mt.Paper(mt.PaperProps{WithBorder: true, Shadow: "md", Radius: mt.MD, Base: mt.Base{P: "30", Mt: mt.XL}}) {
			@mt.TextInput(mt.TextInputProps{Label: "Your email", Placeholder: "me@mantine.dev", Required: true})
			@mt.Group(mt.GroupProps{Justify: "space-between", Base: mt.Base{Mt: mt.LG, Class: "forgot-password__controls"}}) {
				@mt.Anchor(mt.AnchorProps{C: mt.Dimmed, Size: mt.SM, Base: mt.Base{Class: "forgot-password__control"}}) {
					@mt.Center(mt.CenterProps{Inline: true}) {
						@icons.IconArrowLeft(icons.Props{Size: 12, Stroke: 1.5})
						<div style="margin-left:5px">Back to the login page</div>
					}
				}
				@mt.Button(mt.ButtonProps{Base: mt.Base{Class: "forgot-password__control"}}) {
					Reset password
				}
			}
		}
	}
}
