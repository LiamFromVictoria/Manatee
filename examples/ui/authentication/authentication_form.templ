package authentication

import (
	"github.com/you/manatee/icons"
	"github.com/you/manatee/mt"
)

var authenticationFormCSS = templ.NewOnceHandle()

// AuthenticationForm ports ui.mantine.dev AuthenticationForm: a login/register
// card. React's `useToggle` state is replaced with a `data-mode` attribute on
// the card, flipped by a tiny delegated click script; both modes render on
// the server and visibility is pure CSS. Validation stays native
// (`required`, `type="email"`, `minlength`).
templ AuthenticationForm() {
	@authenticationFormCSS.Once() {
		<style>
			.authentication-form__toggle {
				background: none;
				border: none;
				padding: 0;
				cursor: pointer;
			}
			.authentication-form__register-only { display: none; }
			.authentication-form[data-mode='register'] .authentication-form__register-only { display: initial; }
			.authentication-form[data-mode='register'] .authentication-form__login-only { display: none; }
			.authentication-form__register-field { display: none; }
			.authentication-form[data-mode='register'] .authentication-form__register-field { display: block; }
			.authentication-form__divider::part(label) { color: var(--mt-color-bright); opacity: 0.85; }
		</style>
		<script>
			document.addEventListener('click', (e) => {
				const toggle = e.composedPath().find(
					(n) => n instanceof Element && n.classList && n.classList.contains('authentication-form__toggle'),
				);
				if (!toggle) return;
				const root = toggle.closest('.authentication-form');
				if (!root) return;
				root.dataset.mode = root.dataset.mode === 'register' ? 'login' : 'register';
			});
		</script>
	}
	@mt.Paper(mt.PaperProps{
		Radius:     mt.MD,
		WithBorder: true,
		Base:       mt.Base{Class: "authentication-form", P: mt.LG, Attrs: templ.Attributes{"data-mode": "login"}},
	}) {
		@mt.Text(mt.TextProps{Size: mt.LG, Fw: 500, C: "bright"}) {
			Welcome to Mantine, <span class="authentication-form__login-only">login</span><span class="authentication-form__register-only">register</span> with
		}
		@mt.Group(mt.GroupProps{Grow: true, Base: mt.Base{Mb: mt.MD, Mt: mt.MD}}) {
			@mt.Button(mt.ButtonProps{Variant: mt.Default, Radius: "xl", LeftSection: authenticationFormGoogleIcon()}) {
				Google
			}
			@mt.Button(mt.ButtonProps{Variant: mt.Default, Radius: "xl", LeftSection: authenticationFormTwitterIcon()}) {
				Twitter
			}
		}
		@mt.Divider(mt.DividerProps{
			Label:         "Or continue with email",
			LabelPosition: "center",
			Base:          mt.Base{My: mt.LG, Class: "authentication-form__divider"},
		})
		<form>
			@mt.Stack(mt.StackProps{}) {
				<div class="authentication-form__register-field">
					@mt.TextInput(mt.TextInputProps{Label: "Name", Placeholder: "Your name", Name: "name", Radius: mt.MD})
				</div>
				@mt.TextInput(mt.TextInputProps{
					Required: true, Label: "Email", Placeholder: "hello@mantine.dev", Name: "email",
					Type: "email", Radius: mt.MD,
				})
				@mt.PasswordInput(mt.PasswordInputProps{
					Required: true, Label: "Password", Placeholder: "Your password", Name: "password", Radius: mt.MD,
					Base: mt.Base{Attrs: templ.Attributes{"minlength": "7"}},
				})
				<div class="authentication-form__register-field">
					@mt.Checkbox(mt.CheckboxProps{Label: "I accept terms and conditions", Checked: true, Name: "terms"})
				</div>
			}
			@mt.Group(mt.GroupProps{Justify: "space-between", Base: mt.Base{Mt: mt.XL}}) {
				@mt.Anchor(mt.AnchorProps{
					C: "bright", Size: mt.XS,
					Base: mt.Base{Class: "authentication-form__toggle", Attrs: templ.Attributes{"role": "button", "tabindex": "0", "style": "opacity:0.85"}},
				}) {
					<span class="authentication-form__login-only">Don't have an account? Register</span>
					<span class="authentication-form__register-only">Already have an account? Login</span>
				}
				@mt.Button(mt.ButtonProps{Type: "submit", Radius: "xl"}) {
					<span class="authentication-form__login-only">Login</span>
					<span class="authentication-form__register-only">Register</span>
				}
			}
		</form>
	}
}

templ authenticationFormGoogleIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid" viewBox="0 0 256 262" style="width:14px;height:14px">
		<path fill="#4285F4" d="M255.878 133.451c0-10.734-.871-18.567-2.756-26.69H130.55v48.448h71.947c-1.45 12.04-9.283 30.172-26.69 42.356l-.244 1.622 38.755 30.023 2.685.268c24.659-22.774 38.875-56.282 38.875-96.027"></path>
		<path fill="#34A853" d="M130.55 261.1c35.248 0 64.839-11.605 86.453-31.622l-41.196-31.913c-11.024 7.688-25.82 13.055-45.257 13.055-34.523 0-63.824-22.773-74.269-54.25l-1.531.13-40.298 31.187-.527 1.465C35.393 231.798 79.49 261.1 130.55 261.1"></path>
		<path fill="#FBBC05" d="M56.281 156.37c-2.756-8.123-4.351-16.827-4.351-25.82 0-8.994 1.595-17.697 4.206-25.82l-.073-1.73L15.26 71.312l-1.335.635C5.077 89.644 0 109.517 0 130.55s5.077 40.905 13.925 58.602l42.356-32.782"></path>
		<path fill="#EB4335" d="M130.55 50.479c24.514 0 41.05 10.589 50.479 19.438l36.844-35.974C195.245 12.91 165.798 0 130.55 0 79.49 0 35.393 29.301 13.925 71.947l42.211 32.783c10.59-31.477 39.891-54.251 74.414-54.251"></path>
	</svg>
}

templ authenticationFormTwitterIcon() {
	@icons.IconBrandTwitter(icons.Props{Size: 16, Color: "#00ACEE"})
}
