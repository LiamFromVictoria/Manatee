package main

import "github.com/you/manatee/mt"

const iconAt = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/></svg>`

templ TextInputPage() {
	@Demo("Usage", `@mt.TextInput(mt.TextInputProps{Label: "Input label", Description: "Input description", Placeholder: "Input placeholder"})`) {
		@mt.TextInput(mt.TextInputProps{Label: "Input label", Description: "Input description", Placeholder: "Input placeholder", Base: mt.Base{Maw: "320"}})
	}
	@Demo("Variants", `@mt.TextInput(mt.TextInputProps{Variant: mt.Filled})`) {
		for _, v := range []string{mt.Default, mt.Filled, mt.Unstyled} {
			@mt.TextInput(mt.TextInputProps{Label: v, Variant: v, Placeholder: v + " variant", Base: mt.Base{Maw: "320", Mb: mt.SM}})
		}
	}
	@Demo("Sizes", `@mt.TextInput(mt.TextInputProps{Size: mt.LG})`) {
		for _, s := range []string{mt.XS, mt.SM, mt.MD, mt.LG, mt.XL} {
			@mt.TextInput(mt.TextInputProps{Label: "Size " + s, Size: s, Placeholder: s, Base: mt.Base{Maw: "320", Mb: mt.SM}})
		}
	}
	@Demo("Error, required, disabled, sections", `@mt.TextInput(mt.TextInputProps{Label: "Email", Error: "Invalid email", LeftSection: mt.Raw(icon)})`) {
		@mt.TextInput(mt.TextInputProps{Label: "Email", Required: true, Error: "Invalid email", Value: "not-an-email", LeftSection: mt.Raw(iconAt), Base: mt.Base{Maw: "320", Mb: mt.SM}})
		@mt.TextInput(mt.TextInputProps{Label: "Disabled", Disabled: true, Value: "Can't touch this", Base: mt.Base{Maw: "320", Mb: mt.SM}})
		@mt.TextInput(mt.TextInputProps{Label: "Radius xl", Radius: mt.XL, Placeholder: "Rounded", RightSection: mt.Raw(iconAt), Base: mt.Base{Maw: "320"}})
	}
}

templ TextareaPage() {
	@Demo("Usage", `@mt.Textarea(mt.TextareaProps{Label: "Comment", Placeholder: "Your comment"})`) {
		@mt.Textarea(mt.TextareaProps{Label: "Comment", Description: "This is visible to other users", Placeholder: "Your comment", Base: mt.Base{Maw: "320"}})
	}
	@Demo("Autosize", `@mt.Textarea(mt.TextareaProps{Autosize: true, MinRows: 2, MaxRows: 6})`) {
		@mt.Textarea(mt.TextareaProps{Label: "Autosize (2-6 rows)", Autosize: true, MinRows: 2, MaxRows: 6, Placeholder: "Type a few lines, it grows", Base: mt.Base{Maw: "320"}})
	}
	@Demo("Resize", `@mt.Textarea(mt.TextareaProps{Resize: "vertical"})`) {
		@mt.Textarea(mt.TextareaProps{Label: "Resize vertical", Resize: "vertical", Value: "Drag the bottom-right corner", Base: mt.Base{Maw: "320", Mb: mt.SM}})
		@mt.Textarea(mt.TextareaProps{Label: "Resize none (default)", Value: "Not resizable", Base: mt.Base{Maw: "320"}})
	}
	@Demo("Error, required, disabled", `@mt.Textarea(mt.TextareaProps{Required: true, Error: "Required field"})`) {
		@mt.Textarea(mt.TextareaProps{Label: "Bio", Required: true, Error: "Required field", Base: mt.Base{Maw: "320", Mb: mt.SM}})
		@mt.Textarea(mt.TextareaProps{Label: "Disabled", Disabled: true, Value: "Can't edit this", Base: mt.Base{Maw: "320"}})
	}
}

templ PasswordInputPage() {
	@Demo("Usage", `@mt.PasswordInput(mt.PasswordInputProps{Label: "Password"})`) {
		@mt.PasswordInput(mt.PasswordInputProps{Label: "Password", Placeholder: "Your password", Base: mt.Base{Maw: "320"}})
	}
	@Demo("Sizes", `@mt.PasswordInput(mt.PasswordInputProps{Size: mt.LG})`) {
		for _, s := range []string{mt.XS, mt.SM, mt.MD, mt.LG, mt.XL} {
			@mt.PasswordInput(mt.PasswordInputProps{Label: "Size " + s, Size: s, Placeholder: s, Base: mt.Base{Maw: "320", Mb: mt.SM}})
		}
	}
	@Demo("Error, required, disabled", `@mt.PasswordInput(mt.PasswordInputProps{Required: true, Error: "Too short"})`) {
		@mt.PasswordInput(mt.PasswordInputProps{Label: "Password", Required: true, Error: "Too short", Value: "123", Base: mt.Base{Maw: "320", Mb: mt.SM}})
		@mt.PasswordInput(mt.PasswordInputProps{Label: "Disabled", Disabled: true, Value: "secret", Base: mt.Base{Maw: "320"}})
	}
}

templ NumberInputPage() {
	@Demo("Usage", `@mt.NumberInput(mt.NumberInputProps{Label: "Age"})`) {
		@mt.NumberInput(mt.NumberInputProps{Label: "Age", Placeholder: "Your age", Base: mt.Base{Maw: "320"}})
	}
	@Demo("Min, max, step", `@mt.NumberInput(mt.NumberInputProps{Min: new(0.0), Max: new(100.0), Step: 5})`) {
		@mt.NumberInput(mt.NumberInputProps{Label: "0-100, step 5", Min: new(0.0), Max: new(100.0), Step: 5, Value: new(10.0), Base: mt.Base{Maw: "320"}})
	}
	@Demo("Decimals and negative numbers", `@mt.NumberInput(mt.NumberInputProps{DecimalScale: new(2), AllowNegative: new(false)})`) {
		@mt.NumberInput(mt.NumberInputProps{Label: "Price (2 decimals)", DecimalScale: new(2), Prefix: "$", Value: new(19.9), Base: mt.Base{Maw: "320", Mb: mt.SM}})
		@mt.NumberInput(mt.NumberInputProps{Label: "Non-negative only", AllowNegative: new(false), Base: mt.Base{Maw: "320"}})
	}
	@Demo("Prefix, suffix, thousand separator", `@mt.NumberInput(mt.NumberInputProps{Prefix: "$", ThousandSeparator: ","})`) {
		@mt.NumberInput(mt.NumberInputProps{Label: "Amount", Prefix: "$", ThousandSeparator: ",", Value: new(123456.0), Base: mt.Base{Maw: "320", Mb: mt.SM}})
		@mt.NumberInput(mt.NumberInputProps{Label: "Weight", Suffix: " kg", Value: new(72.0), Base: mt.Base{Maw: "320"}})
	}
	@Demo("Clamp behavior", `@mt.NumberInput(mt.NumberInputProps{Min: new(0.0), Max: new(10.0), ClampBehavior: "strict"})`) {
		@mt.NumberInput(mt.NumberInputProps{Label: "Strict clamp (0-10)", Min: new(0.0), Max: new(10.0), ClampBehavior: "strict", Base: mt.Base{Maw: "320", Mb: mt.SM}})
		@mt.NumberInput(mt.NumberInputProps{Label: "No clamp", Min: new(0.0), Max: new(10.0), ClampBehavior: "none", Base: mt.Base{Maw: "320"}})
	}
	@Demo("Hide controls, disabled", `@mt.NumberInput(mt.NumberInputProps{HideControls: true})`) {
		@mt.NumberInput(mt.NumberInputProps{Label: "No stepper", HideControls: true, Base: mt.Base{Maw: "320", Mb: mt.SM}})
		@mt.NumberInput(mt.NumberInputProps{Label: "Disabled", Disabled: true, Value: new(42.0), Base: mt.Base{Maw: "320"}})
	}
}

templ SelectPage() {
	@Demo("Usage", `@mt.Select(mt.SelectProps{Label: "Framework", Data: []mt.SelectItem{{Value: "react", Label: "React"}}})`) {
		@mt.Select(mt.SelectProps{
			Label:       "Framework",
			Placeholder: "Pick one",
			Data: []mt.SelectItem{
				{Value: "react", Label: "React"},
				{Value: "vue", Label: "Vue"},
				{Value: "svelte", Label: "Svelte"},
				{Value: "solid", Label: "Solid", Disabled: true},
			},
			Base: mt.Base{Maw: "320"},
		})
	}
	@Demo("Searchable, clearable", `@mt.Select(mt.SelectProps{Searchable: true, Clearable: true})`) {
		@mt.Select(mt.SelectProps{
			Label:        "Country",
			Placeholder:  "Search countries",
			Searchable:   true,
			Clearable:    true,
			NothingFound: "No country found",
			Data: []mt.SelectItem{
				{Value: "us", Label: "United States"},
				{Value: "ca", Label: "Canada"},
				{Value: "mx", Label: "Mexico"},
				{Value: "br", Label: "Brazil"},
			},
			Base: mt.Base{Maw: "320"},
		})
	}
	@Demo("Groups", `@mt.Select(mt.SelectProps{Groups: []mt.SelectGroup{...}})`) {
		@mt.Select(mt.SelectProps{
			Label: "Fruit",
			Groups: []mt.SelectGroup{
				{Label: "Citrus", Items: []mt.SelectItem{{Value: "orange", Label: "Orange"}, {Value: "lemon", Label: "Lemon"}}},
				{Label: "Berries", Items: []mt.SelectItem{{Value: "strawberry", Label: "Strawberry"}, {Value: "blueberry", Label: "Blueberry"}}},
			},
			Base: mt.Base{Maw: "320"},
		})
	}
	@Demo("No deselect, error, disabled", `@mt.Select(mt.SelectProps{AllowDeselect: new(false)})`) {
		@mt.Select(mt.SelectProps{
			Label:         "Required choice",
			AllowDeselect: new(false),
			Error:         "Please pick one",
			Data:          []mt.SelectItem{{Value: "a", Label: "Option A"}, {Value: "b", Label: "Option B"}},
			Base:          mt.Base{Maw: "320", Mb: mt.SM},
		})
		@mt.Select(mt.SelectProps{
			Label:    "Disabled",
			Disabled: true,
			Value:    "a",
			Data:     []mt.SelectItem{{Value: "a", Label: "Option A"}},
			Base:     mt.Base{Maw: "320"},
		})
	}
}

templ InputsFormPage() {
	@Demo("Form participation", `<form method="post" action="/echo" target="_blank">...</form>`) {
		<form method="post" action="/echo" target="_blank" style="max-width:320px;display:flex;flex-direction:column;gap:1rem;">
			@mt.TextInput(mt.TextInputProps{Name: "name", Label: "Name", Required: true, Placeholder: "Jane Doe"})
			@mt.Textarea(mt.TextareaProps{Name: "bio", Label: "Bio", Autosize: true, MinRows: 2, MaxRows: 5, Placeholder: "Tell us about yourself"})
			@mt.PasswordInput(mt.PasswordInputProps{Name: "password", Label: "Password", Required: true})
			@mt.NumberInput(mt.NumberInputProps{Name: "age", Label: "Age", Min: new(0.0), Max: new(120.0)})
			@mt.Select(mt.SelectProps{
				Name:        "plan",
				Label:       "Plan",
				Placeholder: "Choose a plan",
				Required:    true,
				Data: []mt.SelectItem{
					{Value: "free", Label: "Free"},
					{Value: "pro", Label: "Pro"},
					{Value: "enterprise", Label: "Enterprise"},
				},
			})
			@mt.Button(mt.ButtonProps{Type: "submit"}) {
				Submit
			}
		</form>
	}
}

