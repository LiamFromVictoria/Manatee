package main

import (
	"strconv"
	"strings"

	"github.com/LiamFromVictoria/Manatee/mt"
)

// Layout is the docs chrome. active is the current URL path (highlights the
// matching nav link); an empty title renders body without a page heading.
templ Layout(all []Page, active, title, description string, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>
				if title != "" {
					{ title } · Manatee
				} else {
					Manatee
				}
			</title>
			@mt.Head(mt.HeadProps{})
			<style>
				.docs-header { display: flex; flex: 1; width: 100%; align-items: center; justify-content: space-between; gap: var(--mt-spacing-sm); height: 100%; padding: 0 var(--mt-spacing-md); }
				.docs-brand { font-weight: 700; font-size: var(--mt-font-size-lg); color: var(--mt-color-text); text-decoration: none; margin-right: auto; }
				.docs-group { margin: var(--mt-spacing-md) 0 var(--mt-spacing-xs); padding-left: 0.75rem; font-size: var(--mt-font-size-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--mt-color-dimmed); }
				.docs-main { max-width: 64rem; min-width: 0; padding: var(--mt-spacing-md); }
				@media (min-width: 48em) { .docs-burger { display: none; } }
				.demo { margin-bottom: var(--mt-spacing-xl); }
				.demo h2 { font-size: var(--mt-h3-font-size); margin: 0 0 var(--mt-spacing-sm); }
				.demo-preview { padding: var(--mt-spacing-lg); border: 1px solid var(--mt-color-border); border-radius: var(--mt-radius-md) var(--mt-radius-md) 0 0; }
				.demo-code { margin: 0; padding: var(--mt-spacing-md); background: var(--mt-color-code-bg); border: 1px solid var(--mt-color-border); border-top: 0; border-radius: 0 0 var(--mt-radius-md) var(--mt-radius-md); overflow-x: auto; font-family: var(--mt-font-family-monospace); font-size: var(--mt-font-size-xs); line-height: 1.6; }
				.demo-row { display: flex; flex-wrap: wrap; gap: var(--mt-spacing-md); align-items: center; }
			</style>
		</head>
		<body>
			@mt.AppShell(mt.AppShellProps{HeaderHeight: "60", NavbarWidth: "240", NavbarBreakpoint: mt.SM}) {
				@mt.AppShellHeader(mt.AppShellHeaderProps{}) {
					<div class="docs-header">
						@mt.Burger(mt.BurgerProps{Size: mt.SM, Base: mt.Base{Class: "docs-burger"}})
						<a class="docs-brand" href="/">Manatee</a>
						@mt.Button(mt.ButtonProps{Variant: mt.Default, Size: "compact-sm", Base: mt.Base{Attrs: templ.Attributes{"onclick": templ.JSUnsafeFuncCall("manatee.toggleColorScheme()")}}}) {
							Toggle color scheme
						}
					</div>
				}
				@mt.AppShellNavbar(mt.AppShellNavbarProps{Base: mt.Base{P: mt.SM, Style: "overflow-y:auto"}}) {
					@mt.NavLink(mt.NavLinkProps{Label: "UI blocks", Description: "Ports of ui.mantine.dev", Href: "/ui", Active: strings.HasPrefix(active, "/ui")})
					for i, p := range all {
						if i == 0 || all[i-1].Group != p.Group {
							<div class="docs-group">{ p.Group }</div>
						}
						@mt.NavLink(mt.NavLinkProps{Label: p.Title, Href: "/components/" + p.Slug, Active: active == "/components/"+p.Slug})
					}
				}
				@mt.AppShellMain(mt.AppShellMainProps{}) {
					<div class="docs-main">
						if title != "" {
							@mt.Title(mt.TitleProps{Order: 1, Base: mt.Base{Mb: mt.XS}}) {
								{ title }
							}
							@mt.Text(mt.TextProps{C: mt.Dimmed, Base: mt.Base{Mb: mt.XL}}) {
								{ description }
							}
						}
						@body
					</div>
				}
			}
		</body>
	</html>
}

// Home lists every documented component.
templ Home(all []Page) {
	@mt.Title(mt.TitleProps{Order: 1, Base: mt.Base{Mb: mt.XS}}) {
		Manatee
	}
	@mt.Text(mt.TextProps{C: mt.Dimmed, Base: mt.Base{Mb: mt.XL}}) {
		Mantine-style web components for Go. { strconv.Itoa(len(all)) } documented components.
	}
	@mt.SimpleGrid(mt.SimpleGridProps{Cols: 1, ColsSm: 2, ColsMd: 4, Spacing: mt.SM}) {
		for _, p := range all {
			@mt.NavLink(mt.NavLinkProps{Label: p.Title, Description: p.Group, Href: "/components/" + p.Slug, Base: mt.Base{Style: "border:1px solid var(--mt-color-border);border-radius:var(--mt-radius-md)"}})
		}
	}
}

// Demo renders a titled live preview followed by its source snippet.
templ Demo(title string, code string) {
	<section class="demo">
		<h2>{ title }</h2>
		<div class="demo-preview">
			{ children... }
		</div>
		<pre class="demo-code"><code>{ code }</code></pre>
	</section>
}

// Row lays demo items out horizontally with wrapping.
templ Row() {
	<div class="demo-row">
		{ children... }
	</div>
}
